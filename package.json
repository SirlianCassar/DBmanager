{
  "name": "cairmdb-manager",
  "version": "1.0.0",
  "private": true,
  "author": "Cairm",
  "description": "Gestionnaire de base CairmDB, application de bureau portable.",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist:mac": "electron-builder --mac dir",
    "dist:win": "electron-builder --win portable --x64",
    "dist:linux": "electron-builder --linux AppImage"
  },
  "devDependencies": {
    "electron": "^37.2.6",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.cairm.dbmanager",
    "productName": "DBmanager",
    "files": [
      "src/renderer/index.html",
      "src/renderer/rework.css",
      "src/icons",
      "main.js",
      "preload.js",
      "cairm-full-database.json"
    ],
    "mac": {
      "target": ["dir"],
      "category": "public.app-category.productivity"
    },
    "win": { "target": ["portable"] },
    "linux": { "target": ["AppImage"] }
  }
}
